{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@makon/shared-ui": ["libs/shared-ui/src/index.ts"],
      "@makon/api-client": ["libs/api-client/src/index.ts"]
    },
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "exclude": ["node_modules", "tmp"]
}
