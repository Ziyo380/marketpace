FROM node:22-alpine

WORKDIR /app
COPY frontend-v2/package.json frontend-v2/package-lock.json ./
RUN npm ci
COPY frontend-v2 ./
ARG API_UPSTREAM=http://backend:8080
ENV API_UPSTREAM=${API_UPSTREAM}
RUN ./node_modules/.bin/nx build client

ENV NODE_ENV=production
EXPOSE 3000
CMD ["./node_modules/.bin/next", "start", "apps/client", "-H", "0.0.0.0", "-p", "3000"]
