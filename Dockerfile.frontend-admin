FROM node:22-alpine AS build

WORKDIR /app
COPY frontend-v2/package.json frontend-v2/package-lock.json ./
RUN npm ci
COPY frontend-v2 ./
RUN ./node_modules/.bin/nx build admin

FROM nginx:1.27-alpine
COPY frontend-v2/apps/admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/apps/admin /usr/share/nginx/html
EXPOSE 80
